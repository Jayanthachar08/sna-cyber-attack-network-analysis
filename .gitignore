# Python & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.nox/

# Node & Frontend
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment Variables & Secrets
.env
.env.*
!.env.example

# Logs
*.log
logs/

# CIC-IDS2017 Dataset & Raw Packet Captures (DO NOT COMMIT)
Datasets/
*.pcap
*.pcapng
*.zip
*.tar
*.tar.gz
*.7z

# Data Directories (Preserve directory structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Generated Analysis Artifacts & Large Dumps (Reproducible via pipeline)
results/*.csv
results/*.parquet
results/*.json
!results/.gitkeep

# Retain generated research figures in Git
!results/figures/
!results/figures/*.png
!results/figures/*.jpg
!results/figures/*.svg

# Streamlit Local Cache
.streamlit/

# OS & IDE Files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
